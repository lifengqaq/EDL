<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="380"
        x:Class="lfEDL.Avalonia.Dialogs.XiaomiAuthDialog"
        Title="小米设备认证"
        Width="500" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full">
  
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="20">
    <TextBlock Grid.Row="0" Text="小米设备认证" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center"/>
    
    <!-- Blob 区域 (单行只读，可左右滚动) -->
    <TextBlock Grid.Row="1" Text="Blob：" Margin="0,0,0,4"/>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <TextBox Grid.Column="0" x:Name="BlobBox" IsReadOnly="True" Height="32"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               VerticalContentAlignment="Center" Margin="0,0,8,0"/>
      <Button Grid.Column="1" x:Name="CopyBlobBtn" Content="复制" Width="60"/>
    </Grid>
    
    <!-- 签名输入区域 (多行，文字从顶部开始) -->
    <TextBlock Grid.Row="3" Text="签名：" Margin="0,12,0,4"/>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
      <TextBox Grid.Column="0" x:Name="SignatureBox" AcceptsReturn="True" Height="120"
               TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               Watermark="在此粘贴签名数据 (Base64)" Margin="0,0,8,0"/>
      <Button Grid.Column="1" x:Name="PasteSignatureBtn" Content="粘贴" Width="60" VerticalAlignment="Top"/>
    </Grid>
    
    <!-- 按钮 -->
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,15,0,0">
      <Button x:Name="DoneBtn" Content="完成" Width="100" Classes="accent" IsDefault="True"/>
      <Button x:Name="CancelBtn" Content="取消" Width="100" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
