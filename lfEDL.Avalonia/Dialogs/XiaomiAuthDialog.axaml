<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="350"
        x:Class="lfEDL.Avalonia.Dialogs.XiaomiAuthDialog"
        Title="小米设备认证"
        Width="450" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full">
  
  <Grid RowDefinitions="Auto,Auto,*,Auto,*,Auto" Margin="20">
    <TextBlock Grid.Row="0" Text="小米设备认证" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
    
    <TextBlock Grid.Row="1" Text="请复制下方令牌进行在线授权，获取签名后填入：" TextWrapping="Wrap" Margin="0,0,0,5"/>
    
    <Grid Grid.Row="2" RowDefinitions="*,Auto">
        <TextBox Grid.Row="0" x:Name="TokenBox" TextWrapping="Wrap" IsReadOnly="True" Height="80" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,5"/>
        <Button Grid.Row="1" x:Name="CopyTokenBtn" Content="复制令牌" HorizontalAlignment="Right"/>
    </Grid>
    
    <TextBlock Grid.Row="3" Text="输入签名数据 (Base64)：" Margin="0,15,0,5"/>
    
    <Grid Grid.Row="4" RowDefinitions="*,Auto">
        <TextBox Grid.Row="0" x:Name="SignatureBox" TextWrapping="Wrap" AcceptsReturn="True" Height="100" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,5"/>
        <Button Grid.Row="1" x:Name="PasteSignatureBtn" Content="粘贴签名" HorizontalAlignment="Right"/>
    </Grid>
    
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,15,0,0">
      <Button x:Name="AuthBtn" Content="认证" Width="100" Classes="accent" IsDefault="True"/>
      <Button x:Name="CancelBtn" Content="取消" Width="100" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>

